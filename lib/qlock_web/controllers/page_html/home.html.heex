<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-100 flex flex-col">

  <%!-- Navbar --%>
  <nav class="flex items-center justify-between px-6 py-4 border-b border-base-200 max-w-7xl mx-auto w-full">
    <div class="flex items-center gap-2">
      <img src={~p"/images/logo.svg"} width="32" />
      <span class="font-bold text-xl tracking-tight">Qlock</span>
    </div>

    <div class="hidden md:flex items-center gap-8 text-sm text-base-content/70">
      <a href="#features" class="hover:text-base-content transition-colors">Features</a>
      <a href="#team" class="hover:text-base-content transition-colors">Team</a>
    </div>

    <div class="flex items-center gap-3">
      <%= if assigns[:current_user] do %>
        <a href={~p"/time"} class="btn btn-primary btn-sm gap-2">
          Go to App →
        </a>
      <% else %>
        <a href={~p"/sign-in"} class="btn btn-ghost btn-sm">Sign in</a>
        <a href={~p"/register"} class="btn btn-primary btn-sm">Get started</a>
      <% end %>
    </div>
  </nav>

  <%!-- Hero --%>
  <section class="flex-1 flex items-center max-w-7xl mx-auto w-full px-6 py-16 lg:py-24 gap-12">

    <%!-- Left: text --%>
    <div class="flex-1 max-w-xl">
      <div class="inline-flex items-center gap-2 bg-primary/10 text-primary text-xs font-semibold px-3 py-1 rounded-full mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block" /> Time tracking for teams
      </div>

      <h1 class="text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance">
        Track time,
        <span class="text-primary">manage projects</span>
        &amp; plan your
        <span class="text-success">team's time off</span>
      </h1>

      <p class="mt-6 text-base-content/60 text-lg leading-relaxed">
        Qlock helps your team log daily work, manage projects with categories,
        plan vacations, and analyse the full year — all in one place.
      </p>

      <div class="flex flex-wrap gap-3 mt-8">
        <%= if assigns[:current_user] do %>
          <a href={~p"/time"} class="btn btn-primary gap-2">
            Open Qlock →
          </a>
        <% else %>
          <a href={~p"/register"} class="btn btn-primary gap-2">
            Start tracking →
          </a>
          <a href={~p"/sign-in"} class="btn btn-outline gap-2">
            Sign in
          </a>
        <% end %>
      </div>
    </div>

    <%!-- Right: app mockup --%>
    <div class="hidden lg:flex flex-1 justify-end">
      <div class="w-full max-w-lg rounded-2xl border border-base-300 shadow-2xl overflow-hidden bg-base-100">
        <%!-- Mockup title bar --%>
        <div class="flex items-center gap-1.5 px-4 py-3 bg-base-200 border-b border-base-300">
          <span class="w-3 h-3 rounded-full bg-error/60" />
          <span class="w-3 h-3 rounded-full bg-warning/60" />
          <span class="w-3 h-3 rounded-full bg-success/60" />
          <span class="text-xs text-base-content/30 ml-3">qlock / time</span>
        </div>

        <%!-- Mockup content --%>
        <div class="flex" style="height: 320px;">
          <%!-- Sidebar --%>
          <div class="w-12 bg-base-200 border-r border-base-300 flex flex-col items-center py-3 gap-3">
            <div class="w-6 h-6 rounded bg-primary/20" />
            <div class="w-1 bg-base-300 flex-none h-px w-8 mx-auto" />
            <div class="w-5 h-5 rounded bg-base-300" />
            <div class="w-5 h-5 rounded bg-base-300" />
            <div class="w-5 h-5 rounded bg-primary/40" />
            <div class="mt-auto w-8 h-8 rounded-full bg-primary flex items-center justify-center">
              <span class="text-white text-xs font-bold">J</span>
            </div>
          </div>

          <%!-- Main content --%>
          <div class="flex-1 p-4 space-y-3 overflow-hidden">
            <%!-- Date nav --%>
            <div class="flex items-center justify-between">
              <div class="w-4 h-4 rounded bg-base-300" />
              <div>
                <div class="h-3 w-28 rounded bg-base-content/20 mx-auto mb-1" />
                <div class="h-2 w-16 rounded bg-success/40 mx-auto" />
              </div>
              <div class="w-4 h-4 rounded bg-base-300" />
            </div>

            <%!-- Entries --%>
            <div class="space-y-2 mt-4">
              <div class="rounded-lg bg-base-200 px-3 py-2.5 flex items-center justify-between">
                <div>
                  <div class="h-2.5 w-32 rounded bg-base-content/30 mb-1.5" />
                  <div class="h-2 w-20 rounded bg-base-content/15" />
                </div>
                <div class="flex items-center gap-2">
                  <div class="h-2 w-10 rounded bg-primary/40" />
                  <div class="h-4 w-4 rounded bg-base-300" />
                </div>
              </div>
              <div class="rounded-lg bg-base-200 px-3 py-2.5 flex items-center justify-between">
                <div>
                  <div class="h-2.5 w-24 rounded bg-base-content/30 mb-1.5" />
                  <div class="h-2 w-16 rounded bg-base-content/15" />
                </div>
                <div class="flex items-center gap-2">
                  <div class="h-2 w-8 rounded bg-primary/40" />
                  <div class="h-4 w-4 rounded bg-base-300" />
                </div>
              </div>
              <div class="rounded-lg bg-base-200 px-3 py-2.5 flex items-center justify-between opacity-60">
                <div>
                  <div class="h-2.5 w-20 rounded bg-base-content/20 mb-1.5" />
                  <div class="h-2 w-12 rounded bg-base-content/10" />
                </div>
                <div class="flex items-center gap-2">
                  <div class="h-2 w-12 rounded bg-warning/30" />
                  <div class="h-4 w-4 rounded bg-base-300" />
                </div>
              </div>
            </div>

            <%!-- Add button --%>
            <div class="pt-1">
              <div class="h-7 w-24 rounded-lg bg-primary/20 flex items-center justify-center">
                <div class="h-2 w-16 rounded bg-primary/50" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- Features --%>
  <section id="features" class="max-w-7xl mx-auto w-full px-6 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="card bg-base-200 p-6">
        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
          </svg>
        </div>
        <h3 class="font-semibold mb-2">Daily Time Tracking</h3>
        <p class="text-sm text-base-content/60">
          Log hours per day with task names, projects, categories, and overtime flags. Navigate day by day.
        </p>
      </div>

      <div class="card bg-base-200 p-6">
        <div class="w-10 h-10 rounded-xl bg-success/10 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
          </svg>
        </div>
        <h3 class="font-semibold mb-2">Vacation & Holidays</h3>
        <p class="text-sm text-base-content/60">
          Plan vacations with date ranges. Company holidays and weekends are skipped automatically.
        </p>
      </div>

      <div class="card bg-base-200 p-6">
        <div class="w-10 h-10 rounded-xl bg-warning/10 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" />
          </svg>
        </div>
        <h3 class="font-semibold mb-2">Year Analysis</h3>
        <p class="text-sm text-base-content/60">
          View the full year calendar with working days, holidays, weekends, and vacation days per user.
        </p>
      </div>
    </div>
  </section>

  <%!-- Footer --%>
  <footer class="border-t border-base-200 py-6 text-center text-xs text-base-content/40">
    Qlock — built with Phoenix & Ash Framework
  </footer>
</div>
